# Copy to .env (Prisma CLI reads .env, Next reads .env.local — keep both or symlink)
# Pull the real values straight from Vercel with:  npx vercel env pull .env

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL is what the app queries through. On Supabase this is usually the
# pooled connection (port 6543).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL is the unpooled connection (port 5432). Migrations need it —
# `prisma db push` cannot run through a pooler. If your DATABASE_URL is already
# the direct 5432 one, set this to the same value.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── Auth ────────────────────────────────────────────────────────────────────
# Required. The app refuses to start in production without it.
# Generate: openssl rand -base64 48
JWT_SECRET="your-jwt-secret-here"

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: override the Claude model without a redeploy.
# Model IDs get retired; if every AI route starts 404-ing, set this.
ANTHROPIC_MODEL="claude-sonnet-5"
