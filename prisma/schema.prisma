generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  MERCHANT
  DRIVER
  ADMIN
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  phone         String?
  passwordHash  String
  address       String?
  city          String?
  postalCode    String?
  stripeId      String?
  goals         String[]
  role          UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        Order[]
  subscriptions Subscription[]
  reviews       Review[]
  kitchens      Kitchen[]
}

model Kitchen {
  id              String         @id @default(cuid())
  name            String
  tagline         String?
  description     String?
  cuisine         String
  type            String
  address         String
  city            String
  lat             Float?
  lng             Float?
  imageUrl        String?
  rating          Float          @default(0)
  reviewCount     Int            @default(0)
  isOpen          Boolean        @default(true)
  isHalal         Boolean        @default(false)
  isVeg           Boolean        @default(false)
  pricePerMeal    Float          @default(10)
  weeklyPrice     Float          @default(45)
  weeklySavingsPct Int           @default(15)
  cutoffTime      String         @default("8:00pm")
  deliverySlots   String[]
  commissionPct   Float          @default(10)
  ownerId         String?
  owner           User?          @relation(fields: [ownerId], references: [id])
  // Stripe Connect Express — where this kitchen's 90% lands. payoutsEnabled
  // flips true via webhook once Stripe finishes verifying their details.
  stripeAccountId String?
  payoutsEnabled  Boolean @default(false)

  createdAt       DateTime       @default(now())
  menuItems       MenuItem[]
  orders          Order[]
  subscriptions   Subscription[]
  reviews         Review[]
  weeklyMeals     WeeklyMeal[]
}

model WeeklyMeal {
  id          String   @id @default(cuid())
  kitchenId   String
  kitchen     Kitchen  @relation(fields: [kitchenId], references: [id])
  day         String
  date        String?
  emoji       String   @default("🍛")
  name        String
  description String?
  protein     String?
  calories    Int?
  tags        String[]
  weekOf      DateTime @default(now())
  createdAt   DateTime @default(now())
}

model MenuItem {
  id          String      @id @default(cuid())
  kitchenId   String
  kitchen     Kitchen     @relation(fields: [kitchenId], references: [id])
  name        String
  description String?
  price       Float
  calories    Int?
  protein     Int?
  imageUrl    String?
  isAvailable Boolean     @default(true)
  tags        String[]
  orderItems  OrderItem[]
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  kitchenId       String
  kitchen         Kitchen      @relation(fields: [kitchenId], references: [id])
  status          OrderStatus  @default(PENDING)
  totalAmount     Float
  deliveryFee     Float        @default(0)
  address         String
  deliverySlot    String?
  isWeekly        Boolean      @default(false)
  mealDay         String?
  mealName        String?
  driverName      String?
  driverPhone     String?
  estimatedEta    DateTime?
  stripePaymentId String?
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  price      Float
}

model Subscription {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  kitchenId       String
  kitchen         Kitchen          @relation(fields: [kitchenId], references: [id])
  plan            SubscriptionPlan @default(WEEKLY)
  status          SubStatus        @default(ACTIVE)
  mealsPerWeek    Int              @default(5)
  pricePerWeek    Float
  deliveryDays    String[]
  deliveryTime    String           @default("12:00-13:00")
  stripeSubId     String?
  nextBillingDate DateTime?
  startDate       DateTime         @default(now())
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  orders          Order[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kitchenId String
  kitchen   Kitchen  @relation(fields: [kitchenId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum SubscriptionPlan {
  DAILY
  WEEKLY
  MONTHLY
}

enum SubStatus {
  ACTIVE
  PAUSED
  CANCELLED
}
